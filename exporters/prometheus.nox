import nox.strings
from nox.json import JsonWriter
from nox.http import HttpRequest, HttpResponse
from core.attributes import AttributeEntry, AttributeSet, AttributeValue, estimated_attribute_value_bytes, is_finite, is_sensitive_key
from core.errors import TelemetryError
from core.resource import Resource
from metrics.aggregator import MAX_INT
from metrics.counter_storage import CounterStorageSnapshot
from metrics.histogram import HistogramSnapshot
from metrics.histogram_storage import HistogramStorageSnapshot
from metrics.instruments import InstrumentKind
from metrics.model import MetricCollection, MetricData, MetricSnapshot
from metrics.updown_storage import UpDownStorageSnapshot

MAX_RESOURCE_LABELS: int = 32
MAX_RESOURCE_ALLOWLIST_KEY_BYTES: int = 256
MAX_METRICS_PATH_BYTES: int = 256
MAX_SCRAPE_TARGET_BYTES: int = 4096
PROMETHEUS_CONTENT_TYPE: str = "text/plain; version=0.0.4; charset=utf-8"

def is_ascii_alpha(byte: int) -> bool:
    return byte >= 65 and byte <= 90 or byte >= 97 and byte <= 122

def is_ascii_digit(byte: int) -> bool:
    return byte >= 48 and byte <= 57

def sanitize_prometheus_name(value: str, label: bool) -> str:
    parts: list[str] = []
    index: int = 0
    size: int = nox.strings.byte_len(value)
    while index < size:
        byte: int = nox.strings.byte_at(value, index)
        valid: bool = is_ascii_alpha(byte) or byte == 95
        if index > 0:
            valid = valid or is_ascii_digit(byte)
        if not label:
            valid = valid or byte == 58
        if valid:
            parts.append(nox.strings.char_from_byte(byte))
        else:
            parts.append("_")
        index += 1
    result: str = nox.strings.join(parts, "")
    if nox.strings.byte_len(result) == 0:
        return "_"
    if label and nox.strings.starts_with(result, "__"):
        return "otel" + result
    return result

def strip_unit_annotations(unit: str) -> str:
    size: int = nox.strings.byte_len(unit)
    if size > 63:
        raise TelemetryError("Prometheus unit exceeds the OpenTelemetry unit length bound")
    parts: list[str] = []
    in_annotation: bool = False
    index: int = 0
    while index < size:
        byte: int = nox.strings.byte_at(unit, index)
        if byte > 127:
            raise TelemetryError("Prometheus unit translation requires ASCII input")
        if byte == 123:
            if in_annotation:
                raise TelemetryError("Prometheus unit contains a nested annotation")
            in_annotation = True
        elif byte == 125:
            if not in_annotation:
                raise TelemetryError("Prometheus unit contains an unmatched annotation terminator")
            in_annotation = False
        elif not in_annotation:
            parts.append(nox.strings.char_from_byte(byte))
        index += 1
    if in_annotation:
        raise TelemetryError("Prometheus unit contains an unterminated annotation")
    return nox.strings.join(parts, "")

def sanitize_prometheus_unit_atom(value: str) -> str:
    parts: list[str] = []
    separator_pending: bool = False
    index: int = 0
    size: int = nox.strings.byte_len(value)
    while index < size:
        byte: int = nox.strings.byte_at(value, index)
        if is_ascii_alpha(byte) or is_ascii_digit(byte):
            if separator_pending and len(parts) > 0:
                parts.append("_")
            parts.append(nox.strings.char_from_byte(byte))
            separator_pending = False
        else:
            separator_pending = True
        index += 1
    return nox.strings.join(parts, "")

def prometheus_unit_atom(unit: str, singular: bool) -> str:
    plural: dict[str, str] = {"d": "days", "h": "hours", "min": "minutes", "s": "seconds", "ms": "milliseconds", "us": "microseconds", "ns": "nanoseconds", "By": "bytes", "KiBy": "kibibytes", "MiBy": "mebibytes", "GiBy": "gibibytes", "TiBy": "tebibytes", "kBy": "kilobytes", "MBy": "megabytes", "GBy": "gigabytes", "TBy": "terabytes", "m": "meters", "V": "volts", "A": "amperes", "J": "joules", "W": "watts", "g": "grams", "Cel": "celsius", "Hz": "hertz", "%": "percent"}
    singular_words: dict[str, str] = {"d": "day", "h": "hour", "min": "minute", "s": "second", "ms": "millisecond", "us": "microsecond", "ns": "nanosecond", "By": "byte", "KiBy": "kibibyte", "MiBy": "mebibyte", "GiBy": "gibibyte", "TiBy": "tebibyte", "kBy": "kilobyte", "MBy": "megabyte", "GBy": "gigabyte", "TBy": "terabyte", "m": "meter", "V": "volt", "A": "ampere", "J": "joule", "W": "watt", "g": "gram", "Cel": "celsius", "Hz": "hertz", "%": "percent"}
    if unit == "" or unit == "1":
        return ""
    if singular and unit in singular_words:
        return singular_words[unit]
    if not singular and unit in plural:
        return plural[unit]
    result: str = sanitize_prometheus_unit_atom(unit)
    if result == "":
        raise TelemetryError("Prometheus unit cannot be represented as a metric-name suffix")
    return result

def prometheus_unit_name(unit: str) -> str:
    cleaned: str = strip_unit_annotations(unit)
    if cleaned == "" or cleaned == "1":
        return ""
    numerator_parts: list[str] = []
    denominator_parts: list[str] = []
    has_rate: bool = False
    index: int = 0
    size: int = nox.strings.byte_len(cleaned)
    while index < size:
        byte: int = nox.strings.byte_at(cleaned, index)
        if byte == 47:
            if has_rate:
                raise TelemetryError("Prometheus unit rate contains more than one denominator")
            has_rate = True
        elif has_rate:
            denominator_parts.append(nox.strings.char_from_byte(byte))
        else:
            numerator_parts.append(nox.strings.char_from_byte(byte))
        index += 1
    numerator: str = nox.strings.join(numerator_parts, "")
    if not has_rate:
        return prometheus_unit_atom(numerator, False)
    denominator: str = prometheus_unit_atom(nox.strings.join(denominator_parts, ""), True)
    if denominator == "":
        raise TelemetryError("Prometheus unit rate requires a denominator")
    translated_numerator: str = prometheus_unit_atom(numerator, False)
    if translated_numerator == "":
        return "per_" + denominator
    return translated_numerator + "_per_" + denominator

def without_ascii_suffix(value: str, suffix: str) -> str:
    if suffix == "" or not nox.strings.ends_with(value, suffix):
        return value
    parts: list[str] = []
    limit: int = nox.strings.byte_len(value) - nox.strings.byte_len(suffix)
    index: int = 0
    while index < limit:
        parts.append(nox.strings.char_from_byte(nox.strings.byte_at(value, index)))
        index += 1
    return nox.strings.join(parts, "")

def prometheus_family_name_with_unit(name: str, kind: InstrumentKind, unit: str) -> str:
    base: str = sanitize_prometheus_name(name, False)
    type_suffix: str = ""
    match kind:
        case InstrumentKind.Counter:
            type_suffix = "_total"
        case InstrumentKind.UpDownCounter:
            pass
        case InstrumentKind.Histogram:
            pass
    core: str = without_ascii_suffix(base, type_suffix)
    translated_unit: str = prometheus_unit_name(unit)
    if translated_unit != "":
        unit_suffix: str = "_" + translated_unit
        if not nox.strings.ends_with(core, unit_suffix):
            core += unit_suffix
    return core + type_suffix

def prometheus_family_name(name: str, kind: InstrumentKind) -> str:
    return prometheus_family_name_with_unit(name, kind, "1")

def escape_help(value: str) -> str:
    return nox.strings.replace(nox.strings.replace(value, "\\", "\\\\"), "\n", "\\n")

def escape_label_value(value: str) -> str:
    escaped: str = nox.strings.replace(value, "\\", "\\\\")
    escaped = nox.strings.replace(escaped, "\n", "\\n")
    return nox.strings.replace(escaped, "\"", "\\\"")

def attribute_array_json(value: AttributeValue) -> str:
    writer: JsonWriter = JsonWriter()
    match value:
        case AttributeValue.BooleanArray(bool_values):
            writer.begin_array()
            for bool_item in bool_values:
                writer.write_bool(bool_item)
            writer.end_array()
        case AttributeValue.IntegerArray(int_values):
            writer.begin_array()
            for int_item in int_values:
                writer.write_int(int_item)
            writer.end_array()
        case AttributeValue.FloatArray(float_values):
            writer.begin_array()
            for float_item in float_values:
                writer.write_float(float_item)
            writer.end_array()
        case AttributeValue.TextArray(text_values):
            writer.begin_array()
            for text_item in text_values:
                writer.write_string(text_item)
            writer.end_array()
        case _:
            raise TelemetryError("attribute_array_json requires an array attribute")
    return writer.build()

def attribute_label_value(value: AttributeValue) -> str:
    match value:
        case AttributeValue.Boolean(bool_item):
            if bool_item:
                return "true"
            return "false"
        case AttributeValue.Integer(int_item):
            return str(int_item)
        case AttributeValue.Float(float_item):
            return str(float_item)
        case AttributeValue.Text(text_item):
            return text_item
        case _:
            return attribute_array_json(value)

def render_labels(attributes: AttributeSet, extra_name: str | None, extra_value: str) -> str:
    if len(attributes.entries) == 0 and extra_name is None:
        return ""
    labels: list[str] = []
    seen: dict[str, bool] = {}
    for entry in attributes.entries:
        name: str = sanitize_prometheus_name(entry.key, True)
        if name in seen:
            raise TelemetryError("Prometheus label names collide after normalization")
        if extra_name is not None and name == extra_name:
            raise TelemetryError("Prometheus attribute collides with a reserved sample label")
        seen[name] = True
        labels.append(name + "=\"" + escape_label_value(attribute_label_value(entry.value)) + "\"")
    if extra_name is not None:
        labels.append(extra_name + "=\"" + escape_label_value(extra_value) + "\"")
    return "{" + nox.strings.join(labels, ",") + "}"

def render_family_header(name: str, description: str, kind: InstrumentKind) -> str:
    metric_type: str = "gauge"
    match kind:
        case InstrumentKind.Counter:
            metric_type = "counter"
        case InstrumentKind.UpDownCounter:
            metric_type = "gauge"
        case InstrumentKind.Histogram:
            metric_type = "histogram"
    result: str = ""
    if nox.strings.byte_len(description) > 0:
        result += "# HELP " + name + " " + escape_help(description) + "\n"
    result += "# TYPE " + name + " " + metric_type + "\n"
    return result

def render_counter_points(name: str, snapshot: CounterStorageSnapshot) -> str:
    result: str = ""
    for point in snapshot.points:
        result += name + render_labels(point.attributes, None, "") + " " + str(point.total) + "\n"
    return result

def render_updown_points(name: str, snapshot: UpDownStorageSnapshot) -> str:
    result: str = ""
    for point in snapshot.points:
        result += name + render_labels(point.attributes, None, "") + " " + str(point.total) + "\n"
    return result

def validate_histogram_snapshot(snapshot: HistogramSnapshot) -> None:
    if len(snapshot.bucket_counts) != len(snapshot.boundaries) + 1:
        raise TelemetryError("Prometheus histogram requires N plus one bucket counts")
    if snapshot.count < 0:
        raise TelemetryError("Prometheus histogram count must be nonnegative")
    if not is_finite(snapshot.sum):
        raise TelemetryError("Prometheus histogram sum must be finite")
    previous: float = 0.0
    has_previous: bool = False
    for boundary in snapshot.boundaries:
        if not is_finite(boundary):
            raise TelemetryError("Prometheus histogram boundaries must be finite")
        if has_previous and boundary <= previous:
            raise TelemetryError("Prometheus histogram boundaries must be strictly increasing")
        previous = boundary
        has_previous = True
    cumulative: int = 0
    for count in snapshot.bucket_counts:
        if count < 0:
            raise TelemetryError("Prometheus histogram bucket counts must be nonnegative")
        if count > MAX_INT - cumulative:
            raise TelemetryError("Prometheus histogram cumulative count overflow")
        cumulative += count
    if cumulative != snapshot.count:
        raise TelemetryError("Prometheus histogram bucket counts must sum to count")

def render_histogram_point(name: str, attributes: AttributeSet, snapshot: HistogramSnapshot) -> str:
    validate_histogram_snapshot(snapshot)
    result: str = ""
    cumulative: int = 0
    index: int = 0
    while index < len(snapshot.boundaries):
        cumulative += snapshot.bucket_counts[index]
        result += name + "_bucket" + render_labels(attributes, "le", str(snapshot.boundaries[index])) + " " + str(cumulative) + "\n"
        index += 1
    cumulative += snapshot.bucket_counts[len(snapshot.boundaries)]
    result += name + "_bucket" + render_labels(attributes, "le", "+Inf") + " " + str(cumulative) + "\n"
    result += name + "_sum" + render_labels(attributes, None, "") + " " + str(snapshot.sum) + "\n"
    result += name + "_count" + render_labels(attributes, None, "") + " " + str(snapshot.count) + "\n"
    return result

def render_histogram_points(name: str, snapshot: HistogramStorageSnapshot) -> str:
    result: str = ""
    for point in snapshot.points:
        result += render_histogram_point(name, point.attributes, point.data)
    return result

def render_metric(metric: MetricSnapshot) -> str:
    name: str = prometheus_family_name_with_unit(metric.descriptor.name, metric.descriptor.kind, metric.descriptor.unit)
    result: str = render_family_header(name, metric.descriptor.description, metric.descriptor.kind)
    match metric.data:
        case MetricData.Counter(snapshot):
            match metric.descriptor.kind:
                case InstrumentKind.Counter:
                    pass
                case _:
                    raise TelemetryError("Prometheus metric descriptor and counter data disagree")
            result += render_counter_points(name, snapshot)
        case MetricData.UpDownCounter(snapshot):
            match metric.descriptor.kind:
                case InstrumentKind.UpDownCounter:
                    pass
                case _:
                    raise TelemetryError("Prometheus metric descriptor and up/down counter data disagree")
            result += render_updown_points(name, snapshot)
        case MetricData.Histogram(snapshot):
            match metric.descriptor.kind:
                case InstrumentKind.Histogram:
                    pass
                case _:
                    raise TelemetryError("Prometheus metric descriptor and histogram data disagree")
            result += render_histogram_points(name, snapshot)
    return result

def render_target_info(resource: Resource, resource_attribute_allowlist: list[str]) -> str:
    if len(resource_attribute_allowlist) > MAX_RESOURCE_LABELS:
        raise TelemetryError("Prometheus resource allowlist exceeds max labels")
    allowed: dict[str, bool] = {}
    normalized_labels: dict[str, bool] = {}
    for key in resource_attribute_allowlist:
        key_bytes: int = nox.strings.byte_len(key)
        if key_bytes == 0 or key_bytes > MAX_RESOURCE_ALLOWLIST_KEY_BYTES:
            raise TelemetryError("Prometheus resource allowlist key is invalid")
        if is_sensitive_key(key):
            raise TelemetryError("Prometheus resource allowlist contains a sensitive key")
        if key in allowed:
            raise TelemetryError("Prometheus resource allowlist contains a duplicate key")
        label: str = sanitize_prometheus_name(key, True)
        if label in normalized_labels:
            raise TelemetryError("Prometheus resource labels collide after normalization")
        allowed[key] = True
        normalized_labels[label] = True

    selected: list[AttributeEntry] = []
    selected_bytes: int = 0
    for entry in resource.attributes.entries:
        if entry.key in allowed:
            selected.append(entry)
            selected_bytes += nox.strings.byte_len(entry.key) + estimated_attribute_value_bytes(entry.value)
    if len(selected) == 0:
        return ""
    attributes: AttributeSet = AttributeSet(selected, 0, selected_bytes)
    return "# HELP target_info Target metadata\n# TYPE target_info gauge\ntarget_info" + render_labels(attributes, None, "") + " 1\n"

def render_metrics_with_prefix(collection: MetricCollection, max_output_bytes: int, prefix: str) -> str:
    if max_output_bytes <= 0:
        raise TelemetryError("Prometheus max_output_bytes must be positive")
    result: str = prefix
    if nox.strings.byte_len(result) > max_output_bytes:
        raise TelemetryError("Prometheus payload exceeds max_output_bytes")
    families: dict[str, bool] = {}
    if nox.strings.byte_len(prefix) > 0:
        families["target_info"] = True
    for metric in collection.metrics:
        family: str = prometheus_family_name_with_unit(metric.descriptor.name, metric.descriptor.kind, metric.descriptor.unit)
        if family in families:
            raise TelemetryError("Prometheus metric family names must be unique after normalization")
        families[family] = True
        result += render_metric(metric)
        if nox.strings.byte_len(result) > max_output_bytes:
            raise TelemetryError("Prometheus payload exceeds max_output_bytes")
    return result

def render_metrics(collection: MetricCollection, max_output_bytes: int) -> str:
    return render_metrics_with_prefix(collection, max_output_bytes, "")

def render_metrics_with_resource(collection: MetricCollection, resource: Resource, resource_attribute_allowlist: list[str], max_output_bytes: int) -> str:
    target_info: str = render_target_info(resource, resource_attribute_allowlist)
    return render_metrics_with_prefix(collection, max_output_bytes, target_info)

def request_path(target: str) -> str:
    result: str = ""
    index: int = 0
    while index < nox.strings.byte_len(target):
        byte: int = nox.strings.byte_at(target, index)
        if byte == 63:
            return result
        result += nox.strings.char_from_byte(byte)
        index += 1
    return result

def validate_metrics_path(metrics_path: str) -> None:
    path_bytes: int = nox.strings.byte_len(metrics_path)
    if path_bytes == 0 or path_bytes > MAX_METRICS_PATH_BYTES or not nox.strings.starts_with(metrics_path, "/") or nox.strings.contains(metrics_path, "?") or nox.strings.contains(metrics_path, "#"):
        raise TelemetryError("Prometheus metrics_path must be an absolute path without a query")
    index: int = 0
    while index < path_bytes:
        byte: int = nox.strings.byte_at(metrics_path, index)
        if byte <= 32 or byte == 127:
            raise TelemetryError("Prometheus metrics_path contains an invalid byte")
        index += 1

def scrape_headers() -> dict[str, str]:
    return {"Content-Type": PROMETHEUS_CONTENT_TYPE, "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff"}

def scrape_response(request: HttpRequest, metrics_path: str, collection: MetricCollection, max_output_bytes: int) -> HttpResponse:
    validate_metrics_path(metrics_path)
    if nox.strings.byte_len(request.target) > MAX_SCRAPE_TARGET_BYTES:
        return HttpResponse(414, "request target too long\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    if request_path(request.target) != metrics_path:
        return HttpResponse(404, "not found\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    if request.method != "GET":
        return HttpResponse(405, "method not allowed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Allow": "GET"})
    if nox.strings.byte_len(request.body) > 0:
        return HttpResponse(400, "request body not allowed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    try:
        return HttpResponse(200, render_metrics(collection, max_output_bytes), scrape_headers())
    except TelemetryError as e:
        return HttpResponse(500, "metrics rendering failed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})

def scrape_response_with_resource(request: HttpRequest, metrics_path: str, collection: MetricCollection, resource: Resource, resource_attribute_allowlist: list[str], max_output_bytes: int) -> HttpResponse:
    validate_metrics_path(metrics_path)
    if nox.strings.byte_len(request.target) > MAX_SCRAPE_TARGET_BYTES:
        return HttpResponse(414, "request target too long\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    if request_path(request.target) != metrics_path:
        return HttpResponse(404, "not found\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    if request.method != "GET":
        return HttpResponse(405, "method not allowed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Allow": "GET"})
    if nox.strings.byte_len(request.body) > 0:
        return HttpResponse(400, "request body not allowed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
    try:
        return HttpResponse(200, render_metrics_with_resource(collection, resource, resource_attribute_allowlist, max_output_bytes), scrape_headers())
    except TelemetryError as e:
        return HttpResponse(500, "metrics rendering failed\n", {"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"})
