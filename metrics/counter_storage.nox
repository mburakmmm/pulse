from core.attributes import AttributeSet, AttributeValue, snapshot_attributes
from core.errors import TelemetryError
from core.limits import AttributeLimits, MetricLimits
from metrics.aggregator import MAX_INT, CounterAggregation
from metrics.cardinality import CardinalityTracker, MetricBudget, SeriesRoute, estimated_series_bytes, overflow_attribute_set
from metrics.series import canonical_series_key, copy_attribute_set

COUNTER_AGGREGATION_ESTIMATED_BYTES: int = 256

class CounterSeries:
    attributes: AttributeSet
    aggregation: CounterAggregation

    def __init__(self, attributes: AttributeSet) -> None:
        self.attributes = attributes
        self.aggregation = CounterAggregation()

class CounterPointSnapshot:
    attributes: AttributeSet
    total: int
    overflow: bool

    def __init__(self, attributes: AttributeSet, total: int, overflow: bool) -> None:
        self.attributes = attributes
        self.total = total
        self.overflow = overflow

class CounterStorageSnapshot:
    points: list[CounterPointSnapshot]
    dropped_attributes: int
    overflow_measurements: int

    def __init__(self, points: list[CounterPointSnapshot], dropped_attributes: int, overflow_measurements: int) -> None:
        self.points = points
        self.dropped_attributes = dropped_attributes
        self.overflow_measurements = overflow_measurements

class CounterStorage:
    attribute_limits: AttributeLimits
    tracker: CardinalityTracker
    series: dict[str, CounterSeries]
    overflow_series: CounterSeries
    dropped_attributes: int

    def __init__(self, attribute_limits: AttributeLimits, metric_limits: MetricLimits, budget: MetricBudget) -> None:
        overflow_attributes: AttributeSet = overflow_attribute_set(attribute_limits)
        overflow_key: str = canonical_series_key(overflow_attributes)
        overflow_bytes: int = estimated_series_bytes(overflow_key, overflow_attributes, COUNTER_AGGREGATION_ESTIMATED_BYTES)
        self.attribute_limits = attribute_limits
        self.tracker = CardinalityTracker(metric_limits.max_series_per_instrument - 1, budget, overflow_key, overflow_bytes)
        self.series = {}
        self.overflow_series = CounterSeries(overflow_attributes)
        self.dropped_attributes = 0

    def record(self, value: int, values: dict[str, AttributeValue]) -> None:

        if value < 0:
            raise TelemetryError("counter additions must be nonnegative")
        attributes: AttributeSet = snapshot_attributes(values, self.attribute_limits, True)
        self.note_dropped_attributes(attributes.dropped_count)
        key: str = canonical_series_key(attributes)
        series_bytes: int = estimated_series_bytes(key, attributes, COUNTER_AGGREGATION_ESTIMATED_BYTES)
        route: SeriesRoute = self.tracker.route(key, series_bytes)
        match route:
            case SeriesRoute.Existing:
                self.series[key].aggregation.record(value)
            case SeriesRoute.New:
                new_series: CounterSeries = CounterSeries(attributes)
                new_series.aggregation.record(value)
                self.series[key] = new_series
            case SeriesRoute.Overflow:
                self.overflow_series.aggregation.record(value)

    def note_dropped_attributes(self, count: int) -> None:

        if count <= 0:
            return
        if count > MAX_INT - self.dropped_attributes:
            self.dropped_attributes = MAX_INT
        else:
            self.dropped_attributes += count

    def snapshot(self) -> CounterStorageSnapshot:

        keys: list[str] = []
        for key in self.series:
            keys.append(key)
        keys.sort()
        points: list[CounterPointSnapshot] = []
        for key in keys:
            series: CounterSeries = self.series[key]
            points.append(CounterPointSnapshot(copy_attribute_set(series.attributes), series.aggregation.snapshot().total, False))
        if self.tracker.overflow_measurements > 0:
            points.append(CounterPointSnapshot(copy_attribute_set(self.overflow_series.attributes), self.overflow_series.aggregation.snapshot().total, True))
        return CounterStorageSnapshot(points, self.dropped_attributes, self.tracker.overflow_measurements)
