import nox.strings
from api.context import SpanContext
from api.tracing import ExceptionKind, Span, SpanEvent, SpanKind, SpanLink, SpanSnapshot, SpanStatus
from core.attributes import AttributeSet, AttributeValue, estimated_attribute_value_bytes, is_sensitive_key, snapshot_attribute_entries, snapshot_attribute_value, snapshot_attributes
from core.clock import Clock
from core.errors import TelemetryError
from core.ids import SpanId, TraceId, is_lower_hex
from core.limits import AttributeLimits, RecordLimits, default_record_limits
from core.resource import Resource, snapshot_resource
from core.scope import InstrumentationScope

def copy_span_context(context: SpanContext) -> SpanContext:
    return SpanContext(TraceId(context.trace_id.value), SpanId(context.span_id.value), context.trace_flags, context.tracestate, context.remote)

def snapshot_detail_attributes(values: dict[str, AttributeValue] | None, limits: AttributeLimits, max_count: int, max_bytes: int) -> AttributeSet:
    if values is None:
        return AttributeSet([], 0, 0)
    if max_bytes == 0:
        return AttributeSet([], len(values), 0)
    admitted: dict[str, AttributeValue] = {}
    for key in values:
        if len(admitted) >= max_count:
            break
        admitted[key] = values[key]
    detail_limits: AttributeLimits = AttributeLimits(max_count, limits.max_key_bytes, limits.max_string_bytes, limits.max_array_elements, limits.max_string_array_element_bytes, max_bytes)
    recorded: AttributeSet = snapshot_attributes(admitted, detail_limits, True)
    recorded.dropped_count += len(values) - len(admitted)
    return recorded

class RecordingSpan(Span):
    name: str
    kind: SpanKind
    context: SpanContext
    parent_span_id: SpanId | None
    scope: InstrumentationScope
    resource: Resource | None
    clock: Clock
    limits: AttributeLimits
    content_byte_limit: int
    record_limits: RecordLimits
    detail_bytes: int
    status: SpanStatus
    status_description: str
    events: list[SpanEvent]
    links: list[SpanLink]
    dropped_events: int
    dropped_links: int
    values: dict[str, AttributeValue]
    attribute_bytes: int
    dropped_attributes: int
    start_time_ns: int
    start_monotonic_ns: int
    end_time_ns: int
    duration_ns: int
    ended: bool
    taken: bool

    def __init__(self, name: str, kind: SpanKind, context: SpanContext, parent_span_id: SpanId | None, scope: InstrumentationScope, clock: Clock, limits: AttributeLimits, attribute_byte_limit: int, record_limits: RecordLimits | None = None, resource: Resource | None = None) -> None:
        self.name = name
        self.kind = kind
        self.context = context
        self.parent_span_id = parent_span_id
        self.scope = scope
        self.resource = resource
        self.clock = clock
        self.limits = limits
        self.content_byte_limit = attribute_byte_limit
        if record_limits is None:
            self.record_limits = default_record_limits()
        else:
            self.record_limits = record_limits
        self.detail_bytes = 0
        self.status = SpanStatus.Unset
        self.status_description = ""
        self.events = []
        self.links = []
        self.dropped_events = 0
        self.dropped_links = 0
        self.values = {}
        self.attribute_bytes = 0
        self.dropped_attributes = 0
        self.start_time_ns = clock.wall_time_ns()
        self.start_monotonic_ns = clock.monotonic_time_ns()
        if self.start_time_ns < 0 or self.start_monotonic_ns < 0:
            raise TelemetryError("span clocks must start at nonnegative timestamps")
        self.end_time_ns = 0
        self.duration_ns = 0
        self.ended = False
        self.taken = False

    def span_context(self) -> SpanContext | None:

        return copy_span_context(self.context)

    def is_recording(self) -> bool:

        return not self.ended

    def note_dropped_attribute(self) -> None:

        if self.dropped_attributes < 9223372036854775807:
            self.dropped_attributes += 1

    def set_attribute(self, key: str, value: AttributeValue) -> None:

        if self.ended:
            return
        key_bytes: int = nox.strings.byte_len(key)
        if key_bytes == 0 or key_bytes > self.limits.max_key_bytes or is_sensitive_key(key):
            self.note_dropped_attribute()
            return
        used_without_key: int = self.attribute_bytes
        if key in self.values:
            used_without_key -= key_bytes + estimated_attribute_value_bytes(self.values[key])
        elif len(self.values) >= self.limits.max_attributes:
            self.note_dropped_attribute()
            return
        copied: AttributeValue = AttributeValue.Boolean(False)
        try:
            copied = snapshot_attribute_value(value, self.limits)
        except TelemetryError as error:
            self.note_dropped_attribute()
            return
        entry_bytes: int = key_bytes + estimated_attribute_value_bytes(copied)
        if entry_bytes > min(self.limits.max_total_bytes, self.content_byte_limit - self.detail_bytes) - used_without_key:
            self.note_dropped_attribute()
            return
        self.values[key] = copied
        self.attribute_bytes = used_without_key + entry_bytes

    def remaining_bytes(self) -> int:

        return self.content_byte_limit - self.attribute_bytes - self.detail_bytes

    def set_status(self, status: SpanStatus, description: str = "") -> None:

        if self.ended:
            return
        match self.status:
            case SpanStatus.Ok:
                return
            case _:
                pass
        match status:
            case SpanStatus.Unset:
                return
            case _:
                pass
        self.detail_bytes -= nox.strings.byte_len(self.status_description)
        self.status_description = ""
        self.status = status
        match status:
            case SpanStatus.Error:
                description_bytes: int = nox.strings.byte_len(description)
                if description_bytes <= 255 and description_bytes <= self.remaining_bytes():
                    self.status_description = description
                    self.detail_bytes += description_bytes
            case _:
                pass

    def add_event(self, name: str, attributes: dict[str, AttributeValue] | None = None, time_ns: int | None = None) -> None:

        self.append_event(name, attributes, time_ns, False)

    def record_exception(self, kind: ExceptionKind) -> None:

        if self.ended:
            return
        type_name: str = "Exception"
        match kind:
            case ExceptionKind.ValueError:
                type_name = "ValueError"
            case ExceptionKind.CancelledError:
                type_name = "CancelledError"
            case _:
                pass
        self.append_event("exception", {"exception.type": AttributeValue.Text(type_name)}, None, True)

    def append_event(self, name: str, attributes: dict[str, AttributeValue] | None, time_ns: int | None, require_attribute: bool) -> None:

        if self.ended:
            return
        name_bytes: int = nox.strings.byte_len(name)
        fixed_bytes: int = 32 + name_bytes
        if name_bytes == 0 or name_bytes > 255 or len(self.events) >= self.record_limits.max_events or fixed_bytes > self.remaining_bytes():
            self.dropped_events = min(self.dropped_events, 9223372036854775806) + 1
            return
        observed_ns: int = 0
        if time_ns is not None:
            if time_ns < 0:
                self.dropped_events = min(self.dropped_events, 9223372036854775806) + 1
                return
            observed_ns = time_ns
        else:
            observed_ns = max(0, self.clock.wall_time_ns())
        max_bytes: int = min(self.limits.max_total_bytes, min(self.record_limits.max_event_attribute_bytes, self.remaining_bytes() - fixed_bytes))
        recorded: AttributeSet = snapshot_detail_attributes(attributes, self.limits, self.record_limits.max_event_attributes, max_bytes)
        if require_attribute and recorded.len() == 0:
            self.dropped_events = min(self.dropped_events, 9223372036854775806) + 1
            return
        self.events.append(SpanEvent(name, observed_ns, recorded))
        self.detail_bytes += fixed_bytes + recorded.estimated_bytes

    def add_link(self, context: SpanContext, attributes: dict[str, AttributeValue] | None = None) -> None:

        if self.ended:
            return
        state_bytes: int = nox.strings.byte_len(context.tracestate)
        fixed_bytes: int = 96 + state_bytes
        if state_bytes > 512 or len(self.links) >= self.record_limits.max_links or fixed_bytes > self.remaining_bytes():
            self.dropped_links = min(self.dropped_links, 9223372036854775806) + 1
            return
        if not is_lower_hex(context.trace_id.value, 16) or not is_lower_hex(context.span_id.value, 8):
            self.dropped_links = min(self.dropped_links, 9223372036854775806) + 1
            return
        max_bytes: int = min(self.limits.max_total_bytes, min(self.record_limits.max_link_attribute_bytes, self.remaining_bytes() - fixed_bytes))
        recorded: AttributeSet = snapshot_detail_attributes(attributes, self.limits, self.record_limits.max_link_attributes, max_bytes)
        self.links.append(SpanLink(copy_span_context(context), recorded))
        self.detail_bytes += fixed_bytes + recorded.estimated_bytes

    def end(self) -> None:

        if self.ended:
            return
        wall: int = self.clock.wall_time_ns()
        monotonic: int = self.clock.monotonic_time_ns()
        self.end_time_ns = max(self.start_time_ns, wall)
        self.duration_ns = max(self.start_monotonic_ns, monotonic) - self.start_monotonic_ns
        self.ended = True

    def take_snapshot(self) -> SpanSnapshot | None:

        if not self.ended or self.taken:
            return None
        attributes: AttributeSet = snapshot_attributes(self.values, self.limits, True)
        attributes.dropped_count = self.dropped_attributes
        scope: InstrumentationScope = InstrumentationScope(self.scope.name, self.scope.version, self.scope.schema_url, {}, self.limits)
        scope.attributes = snapshot_attribute_entries(self.scope.attributes, self.limits)
        snapshot: SpanSnapshot = SpanSnapshot(self.name, self.kind, copy_span_context(self.context), self.parent_span_id, scope, self.start_time_ns, self.end_time_ns, self.duration_ns, attributes)
        snapshot.resource = snapshot_resource(self.resource, self.limits)
        snapshot.status = self.status
        snapshot.status_description = self.status_description
        snapshot.events = self.events
        snapshot.links = self.links
        snapshot.dropped_events = self.dropped_events
        snapshot.dropped_links = self.dropped_links
        self.values = {}
        self.events = []
        self.links = []
        self.taken = True
        return snapshot
