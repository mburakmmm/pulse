import nox.strings
from api.context import SpanContext
from tracing.baggage import BaggageEntry, format_baggage, parse_baggage, valid_token
from tracing.traceparent import extract_traceparent, format_traceparent
from tracing.tracestate import normalize_tracestate

def find_header(headers: dict[str, str], name: str) -> str | None:
    found: str = ""
    for key in headers:
        if nox.strings.eq_ignore_case(key, name):
            if found != "":
                return None
            found = key
    return found

def extract_trace_context(headers: dict[str, str]) -> SpanContext | None:
    parent: SpanContext | None = extract_traceparent(headers)
    if parent is None:
        return None
    key: str | None = find_header(headers, "tracestate")
    if key is not None and key != "":
        state: str | None = normalize_tracestate(headers[key])
        if state is not None:
            parent.tracestate = state
    return parent

def inject_trace_context(context: SpanContext, headers: dict[str, str], overwrite: bool = False) -> bool:
    if len(headers) > 256:
        return False
    existing_parent: str | None = find_header(headers, "traceparent")
    existing_state: str | None = find_header(headers, "tracestate")
    if existing_parent is None or existing_state is None:
        return False
    parent_key: str = existing_parent
    state_key: str = existing_state
    if not overwrite and (parent_key != "" or state_key != ""):
        return False
    parent: str = format_traceparent(context)
    normalized: str | None = normalize_tracestate(context.tracestate)
    state: str = ""
    if normalized is not None:
        state = normalized
    if parent_key != "":
        previous_parent: str = headers[parent_key]
        if nox.strings.byte_len(previous_parent) == nox.strings.byte_len(parent) and previous_parent == parent:
            # A pass-through parent must keep its original tracestate.
            return True
    final_size: int = len(headers)
    if parent_key == "":
        final_size += 1
    if state_key == "" and state != "":
        final_size += 1
    elif state_key != "" and state == "":
        final_size -= 1
    if final_size > 256:
        return False
    if parent_key == "":
        parent_key = "traceparent"
    if state != "":
        if state_key == "":
            state_key = "tracestate"
        headers[state_key] = state
    elif state_key != "":
        del headers[state_key]
    headers[parent_key] = parent
    return True

def extract_baggage(headers: dict[str, str]) -> list[BaggageEntry] | None:
    if len(headers) > 256:
        return None
    key: str | None = find_header(headers, "baggage")
    if key is None:
        return None
    if key == "":
        return []
    return parse_baggage(headers[key])

def inject_baggage(entries: list[BaggageEntry], headers: dict[str, str], allowed_keys: list[str] | None = None) -> bool:
    if len(headers) > 256:
        return False
    existing: list[str] = []
    for key in headers:
        if nox.strings.eq_ignore_case(key, "baggage"):
            existing.append(key)
    wire: str = ""
    if allowed_keys is not None and len(allowed_keys) > 0:
        if len(entries) > 64 or len(allowed_keys) > 64:
            return False
        for key in allowed_keys:
            if not valid_token(key):
                return False
        selected: list[BaggageEntry] = []
        seen: dict[str, bool] = {}
        for entry in entries:
            if entry.key in allowed_keys and entry.key not in seen:
                selected.append(BaggageEntry(entry.key, entry.value, []))
                seen[entry.key] = True
        formatted: str | None = format_baggage(selected)
        if formatted is None:
            return False
        wire = formatted
    if wire != "" and len(headers) - len(existing) >= 256:
        return False
    for key in existing:
        del headers[key]
    if wire != "":
        headers["baggage"] = wire
    return True
