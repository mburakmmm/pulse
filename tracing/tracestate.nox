import nox.strings
from tracing.traceparent import read_identifier

def is_ows(byte: int) -> bool:
    return byte == 32 or byte == 9

def trim_member(member: str) -> str:
    start: int = 0
    end: int = nox.strings.byte_len(member)
    while start < end and is_ows(nox.strings.byte_at(member, start)):
        start += 1
    while end > start and is_ows(nox.strings.byte_at(member, end - 1)):
        end -= 1
    return read_identifier(member, start, end - start)

def is_lower_alpha(byte: int) -> bool:
    return byte >= 97 and byte <= 122

def is_digit(byte: int) -> bool:
    return byte >= 48 and byte <= 57

def valid_key_part(key: str, max_bytes: int, digit_first: bool) -> bool:
    length: int = nox.strings.byte_len(key)
    if length == 0 or length > max_bytes:
        return False
    first: int = nox.strings.byte_at(key, 0)
    if not is_lower_alpha(first) and not (digit_first and is_digit(first)):
        return False
    for index in range(1, length):
        byte: int = nox.strings.byte_at(key, index)
        if not (is_lower_alpha(byte) or is_digit(byte) or byte == 95 or byte == 45 or byte == 42 or byte == 47):
            return False
    return True

def valid_key(key: str) -> bool:
    parts: list[str] = nox.strings.split(key, "@")
    if len(parts) == 1:
        return valid_key_part(parts[0], 256, False)
    if len(parts) == 2:
        return valid_key_part(parts[0], 241, True) and valid_key_part(parts[1], 14, False)
    return False

def valid_value(value: str) -> bool:
    length: int = nox.strings.byte_len(value)
    if length == 0 or length > 256:
        return False
    for index in range(length):
        byte: int = nox.strings.byte_at(value, index)
        if byte < 32 or byte > 126 or byte == 44 or byte == 61:
            return False
    return True

def normalize_tracestate(header: str) -> str | None:
    if nox.strings.byte_len(header) > 512:
        return None
    members: list[str] = nox.strings.split(header, ",")
    if len(members) > 32:
        return None
    seen: dict[str, bool] = {}
    normalized: list[str] = []
    for raw in members:
        member: str = trim_member(raw)
        if member == "":
            continue
        pair: list[str] = nox.strings.split(member, "=")
        if len(pair) != 2:
            return None
        key: str = pair[0]
        if not valid_key(key) or not valid_value(pair[1]) or key in seen:
            return None
        seen[key] = True
        normalized.append(member)
    return nox.strings.join(normalized, ",")
