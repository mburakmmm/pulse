from api.context import SpanContext, TelemetryContext
from core.attributes import AttributeSet, AttributeValue
from core.ids import SpanId
from core.scope import InstrumentationScope

enum SpanKind:
    Internal
    Server
    Client
    Producer
    Consumer

enum SpanStatus:
    Unset
    Error
    Ok

class SpanEvent:
    name: str
    time_ns: int
    attributes: AttributeSet

    def __init__(self, name: str, time_ns: int, attributes: AttributeSet) -> None:
        self.name = name
        self.time_ns = time_ns
        self.attributes = attributes

class SpanLink:
    context: SpanContext
    attributes: AttributeSet

    def __init__(self, context: SpanContext, attributes: AttributeSet) -> None:
        self.context = context
        self.attributes = attributes

class SpanSnapshot:
    name: str
    kind: SpanKind
    context: SpanContext
    parent_span_id: SpanId | None
    scope: InstrumentationScope
    start_time_ns: int
    end_time_ns: int
    duration_ns: int
    attributes: AttributeSet
    status: SpanStatus
    status_description: str
    events: list[SpanEvent]
    links: list[SpanLink]
    dropped_events: int
    dropped_links: int

    def __init__(self, name: str, kind: SpanKind, context: SpanContext, parent_span_id: SpanId | None, scope: InstrumentationScope, start_time_ns: int, end_time_ns: int, duration_ns: int, attributes: AttributeSet) -> None:
        self.name = name
        self.kind = kind
        self.context = context
        self.parent_span_id = parent_span_id
        self.scope = scope
        self.start_time_ns = start_time_ns
        self.end_time_ns = end_time_ns
        self.duration_ns = duration_ns
        self.attributes = attributes
        self.status = SpanStatus.Unset
        self.status_description = ""
        self.events = []
        self.links = []
        self.dropped_events = 0
        self.dropped_links = 0

class Span:
    def span_context(self) -> SpanContext | None:
        return None

    def is_recording(self) -> bool:

        return False

    def set_attribute(self, key: str, value: AttributeValue) -> None:

        return

    def set_status(self, status: SpanStatus, description: str = "") -> None:

        return

    def add_event(self, name: str, attributes: dict[str, AttributeValue] | None = None, time_ns: int | None = None) -> None:

        return

    def add_link(self, context: SpanContext, attributes: dict[str, AttributeValue] | None = None) -> None:

        return

    def end(self) -> None:

        return

    def take_snapshot(self) -> SpanSnapshot | None:

        return None

class Tracer:
    def start_span(self, name: str, parent: TelemetryContext) -> Span:
        return Span()

class TracerProvider:
    def get_tracer(self, name: str, version: str | None, schema_url: str | None) -> Tracer:
        return Tracer()

class NoopSpan(Span):
    inherited_context: SpanContext | None
    ended: bool

    def __init__(self, inherited_context: SpanContext | None) -> None:
        self.inherited_context = inherited_context
        self.ended = False

    def span_context(self) -> SpanContext | None:

        return self.inherited_context

    def is_recording(self) -> bool:

        return False

    def set_attribute(self, key: str, value: AttributeValue) -> None:

        return

    def end(self) -> None:

        self.ended = True

class NoopTracer(Tracer):
    def start_span(self, name: str, parent: TelemetryContext) -> Span:
        return NoopSpan(parent.span)

class NoopTracerProvider(TracerProvider):
    def get_tracer(self, name: str, version: str | None, schema_url: str | None) -> Tracer:
        return NoopTracer()
