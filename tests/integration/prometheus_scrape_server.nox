import nox.http
import nox.os
from nox.http import HttpRequest, HttpResponse
from api.metrics import Counter, Meter
from core.attributes import AttributeValue, snapshot_attributes
from core.limits import default_attribute_limits, default_metric_limits, default_record_limits
from core.resource import Resource
from exporters.prometheus import scrape_response_with_resource
from metrics.model import MetricCollection
from metrics.provider import ConcurrentMeterProvider

def collect_fixture() -> MetricCollection:
    provider: ConcurrentMeterProvider = ConcurrentMeterProvider(default_attribute_limits(), default_metric_limits(), default_record_limits())
    try:
        meter: Meter = provider.get_meter("pulse.scrape.integration", "0.3.0", None)
        counter: Counter = meter.create_counter("http.server.requests", "1", "HTTP requests")
        counter.add(7, {"method": AttributeValue.Text("GET")})
        return provider.collection_snapshot(100, 200)
    finally:
        provider.close_after_join()

collection: MetricCollection = collect_fixture()
resource: Resource = Resource(snapshot_attributes({"service.name": AttributeValue.Text("scrape-integration"), "authorization": AttributeValue.Text("must-not-export")}, default_attribute_limits(), True))

def handle(request: HttpRequest) -> HttpResponse:
    response: HttpResponse = scrape_response_with_resource(request, "/metrics", collection, resource, ["service.name"], 8192)
    nox.http.shutdown()
    return response

port: int = int(nox.os.arg(1))
nox.http.configure(1, 4096, 1000, 8, 1000, 0, "127.0.0.1")
nox.http.serve(port, handle, 1)
