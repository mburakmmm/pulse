import nox.test

protocol Described:
    def describe(self) -> str:
        pass

class IntDescription:
    value: int

    def __init__(self, value: int) -> None:
        self.value = value

    def describe(self) -> str:

        return "int:" + str(self.value)

class TextDescription:
    value: str

    def __init__(self, value: str) -> None:
        self.value = value

    def describe(self) -> str:

        return "str:" + self.value

def first[T](values: list[T]) -> T:
    return values[0]

def optional_length(value: str | None) -> int:
    if value is None:
        return 0
    return len(value)

nox.test.assert_eq_str(first(["a", "b"]), "a", "generic function is inferred and specialized")

descriptions: list[Described] = [IntDescription(7), TextDescription("safe")]
nox.test.assert_eq_str(descriptions[0].describe(), "int:7", "protocol value dispatches to the first concrete class")
nox.test.assert_eq_str(descriptions[1].describe(), "str:safe", "protocol list supports heterogeneous implementations")
nox.test.assert_eq_int(optional_length(None), 0, "optional None branch narrows safely")
nox.test.assert_eq_int(optional_length("nox"), 3, "optional value branch narrows safely")
