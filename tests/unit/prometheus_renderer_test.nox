import nox.strings
import nox.test
from nox.http import HttpRequest, HttpResponse
from core.attributes import AttributeSet, AttributeValue, snapshot_attributes
from core.errors import TelemetryError
from core.limits import default_attribute_limits
from core.resource import Resource
from exporters.prometheus import PROMETHEUS_CONTENT_TYPE, escape_help, escape_label_value, prometheus_family_name, prometheus_family_name_with_unit, prometheus_unit_name, render_metrics, render_metrics_with_resource, sanitize_prometheus_name, scrape_response_with_resource
from metrics.counter_storage import CounterPointSnapshot, CounterStorageSnapshot
from metrics.histogram import HistogramSnapshot
from metrics.histogram_storage import HistogramPointSnapshot, HistogramStorageSnapshot
from metrics.instruments import InstrumentKind
from metrics.model import MetricCollection, MetricData, MetricDescriptorSnapshot, MetricScopeSnapshot, MetricSnapshot
from metrics.updown_storage import UpDownPointSnapshot, UpDownStorageSnapshot

scope: MetricScopeSnapshot = MetricScopeSnapshot("pulse.prometheus.tests", "0.3.0", None, snapshot_attributes({}, default_attribute_limits(), True))
counter_attributes: AttributeSet = snapshot_attributes({"http.route": AttributeValue.Text("/orders\n\"quoted\""), "attempt": AttributeValue.Integer(2)}, default_attribute_limits(), True)
gauge_attributes: AttributeSet = snapshot_attributes({"state": AttributeValue.Text("ready")}, default_attribute_limits(), True)
histogram_attributes: AttributeSet = snapshot_attributes({"route": AttributeValue.Text("/orders")}, default_attribute_limits(), True)

counter_data: CounterStorageSnapshot = CounterStorageSnapshot([CounterPointSnapshot(counter_attributes, 9007199254740993, False)], 0, 0)
gauge_data: UpDownStorageSnapshot = UpDownStorageSnapshot([UpDownPointSnapshot(gauge_attributes, -2, False)], 0, 0)
histogram_data: HistogramStorageSnapshot = HistogramStorageSnapshot([HistogramPointSnapshot(histogram_attributes, HistogramSnapshot([1.0, 5.0], [1, 2, 1], 4, 13.0, True, 1.0, 6.0), False)], 0, 0)

metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("http.requests", InstrumentKind.Counter, "1", "request\\count\nline"), 100, 200, MetricData.Counter(counter_data)), MetricSnapshot(scope, MetricDescriptorSnapshot("active-requests", InstrumentKind.UpDownCounter, "1", ""), 100, 200, MetricData.UpDownCounter(gauge_data)), MetricSnapshot(scope, MetricDescriptorSnapshot("request/duration", InstrumentKind.Histogram, "ms", "request latency"), 100, 200, MetricData.Histogram(histogram_data))]

payload: str = render_metrics(MetricCollection(100, 200, metrics), 16384)
nox.test.assert_true(nox.strings.contains(payload, "# HELP http_requests_total request\\\\count\\nline\n"), "HELP text escapes backslashes and newlines")
nox.test.assert_true(nox.strings.contains(payload, "# TYPE http_requests_total counter\n"), "counter families use the counter type and total suffix")
nox.test.assert_true(nox.strings.contains(payload, "http_requests_total{attempt=\"2\",http_route=\"/orders\\n\\\"quoted\\\"\"} 9007199254740993\n"), "counter samples retain exact int64 values and escaped deterministic labels")
nox.test.assert_true(nox.strings.contains(payload, "# TYPE active_requests gauge\n"), "up/down counters map to gauges")
nox.test.assert_true(nox.strings.contains(payload, "active_requests{state=\"ready\"} -2\n"), "gauges retain signed values")
nox.test.assert_true(nox.strings.contains(payload, "request_duration_milliseconds_bucket{route=\"/orders\",le=\"1"), "histograms emit cumulative finite buckets with the translated unit suffix")
nox.test.assert_true(nox.strings.contains(payload, "request_duration_milliseconds_bucket{route=\"/orders\",le=\"+Inf\"} 4\n"), "histograms emit a positive-infinity bucket equal to count")
nox.test.assert_true(nox.strings.contains(payload, "request_duration_milliseconds_count{route=\"/orders\"} 4\n"), "histograms emit count")
nox.test.assert_true(nox.strings.contains(payload, "request_duration_milliseconds_sum{route=\"/orders\"} 13"), "unit naming does not rescale histogram values")

resource: Resource = Resource(snapshot_attributes({"service.name": AttributeValue.Text("checkout-api"), "service.version": AttributeValue.Text("1.2.3"), "deployment.environment.name": AttributeValue.Text("production")}, default_attribute_limits(), True))
resource_payload: str = render_metrics_with_resource(MetricCollection(100, 200, metrics), resource, ["service.name", "deployment.environment.name"], 16384)
nox.test.assert_true(nox.strings.starts_with(resource_payload, "# HELP target_info Target metadata\n# TYPE target_info gauge\ntarget_info{deployment_environment_name=\"production\",service_name=\"checkout-api\"} 1\n"), "target_info exposes only explicitly allowlisted resource labels in deterministic order")
nox.test.assert_true(not nox.strings.contains(resource_payload, "service_version"), "target_info does not promote non-allowlisted resource attributes")
nox.test.assert_eq_str(render_metrics_with_resource(MetricCollection(100, 200, []), resource, [], 1024), "", "an empty resource allowlist emits no target_info family")

nox.test.assert_eq_str(sanitize_prometheus_name("9.bad/name", False), "__bad_name", "invalid metric-name bytes normalize deterministically")
nox.test.assert_eq_str(sanitize_prometheus_name("__internal", True), "otel__internal", "reserved double-underscore labels are moved out of the reserved namespace")
nox.test.assert_eq_str(prometheus_family_name("already_total", InstrumentKind.Counter), "already_total", "counter total suffix is idempotent")
nox.test.assert_eq_str(prometheus_unit_name("ms{request}"), "milliseconds", "UCUM annotations are dropped before translating known units")
nox.test.assert_eq_str(prometheus_unit_name("By/s"), "bytes_per_second", "UCUM rates use plural numerators and singular denominators")
nox.test.assert_eq_str(prometheus_unit_name("{request}/s"), "per_second", "annotation-only numerators produce a bounded rate suffix")
nox.test.assert_eq_str(prometheus_family_name_with_unit("requests_total", InstrumentKind.Counter, "s"), "requests_seconds_total", "unit suffixes precede counter type suffixes")
nox.test.assert_eq_str(prometheus_family_name_with_unit("latency_seconds", InstrumentKind.Histogram, "s"), "latency_seconds", "existing unit suffixes are not duplicated")
nox.test.assert_eq_str(escape_help("a\\b\nc"), "a\\\\b\\nc", "HELP escaping follows text exposition rules")
nox.test.assert_eq_str(escape_label_value("a\\b\n\"c"), "a\\\\b\\n\\\"c", "label escaping follows text exposition rules")

malformed_unit_failed: bool = False
try:
    prometheus_unit_name("ms{request")
except TelemetryError as e:
    malformed_unit_failed = True
nox.test.assert_true(malformed_unit_failed, "malformed UCUM annotations fail closed")

too_small_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, metrics), 1)
except TelemetryError as e:
    too_small_failed = True
nox.test.assert_true(too_small_failed, "renderer rejects payloads beyond the configured byte bound")

invalid_histogram: HistogramStorageSnapshot = HistogramStorageSnapshot([HistogramPointSnapshot(histogram_attributes, HistogramSnapshot([1.0], [1, 1], 3, 2.0, True, 1.0, 1.0), False)], 0, 0)
invalid_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("invalid", InstrumentKind.Histogram, "1", ""), 100, 200, MetricData.Histogram(invalid_histogram))]
invalid_histogram_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, invalid_metrics), 1024)
except TelemetryError as e:
    invalid_histogram_failed = True
nox.test.assert_true(invalid_histogram_failed, "renderer rejects inconsistent histogram snapshots")

collision_data: CounterStorageSnapshot = CounterStorageSnapshot([CounterPointSnapshot(snapshot_attributes({}, default_attribute_limits(), True), 1, False)], 0, 0)
collision_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("same.name", InstrumentKind.Counter, "1", ""), 100, 200, MetricData.Counter(collision_data)), MetricSnapshot(scope, MetricDescriptorSnapshot("same/name", InstrumentKind.Counter, "1", ""), 100, 200, MetricData.Counter(collision_data))]
family_collision_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, collision_metrics), 1024)
except TelemetryError as e:
    family_collision_failed = True
nox.test.assert_true(family_collision_failed, "renderer rejects family collisions after name normalization")

unit_collision_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("latency", InstrumentKind.UpDownCounter, "ms", ""), 100, 200, MetricData.UpDownCounter(gauge_data)), MetricSnapshot(scope, MetricDescriptorSnapshot("latency_milliseconds", InstrumentKind.UpDownCounter, "1", ""), 100, 200, MetricData.UpDownCounter(gauge_data))]
unit_collision_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, unit_collision_metrics), 1024)
except TelemetryError as e:
    unit_collision_failed = True
nox.test.assert_true(unit_collision_failed, "renderer rejects family collisions introduced by unit translation")

colliding_attributes: AttributeSet = snapshot_attributes({"label.one": AttributeValue.Text("first"), "label/one": AttributeValue.Text("second")}, default_attribute_limits(), True)
label_collision_data: CounterStorageSnapshot = CounterStorageSnapshot([CounterPointSnapshot(colliding_attributes, 1, False)], 0, 0)
label_collision_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("label_collision", InstrumentKind.Counter, "1", ""), 100, 200, MetricData.Counter(label_collision_data))]
label_collision_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, label_collision_metrics), 1024)
except TelemetryError as e:
    label_collision_failed = True
nox.test.assert_true(label_collision_failed, "renderer rejects label collisions after name normalization")

kind_mismatch_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("kind_mismatch", InstrumentKind.Counter, "1", ""), 100, 200, MetricData.Histogram(histogram_data))]
kind_mismatch_failed: bool = False
try:
    render_metrics(MetricCollection(100, 200, kind_mismatch_metrics), 1024)
except TelemetryError as e:
    kind_mismatch_failed = True
nox.test.assert_true(kind_mismatch_failed, "renderer rejects descriptor and metric-data kind mismatches")

sensitive_allowlist_failed: bool = False
try:
    render_metrics_with_resource(MetricCollection(100, 200, []), resource, ["authorization"], 1024)
except TelemetryError as e:
    sensitive_allowlist_failed = True
nox.test.assert_true(sensitive_allowlist_failed, "target_info rejects sensitive resource keys even when explicitly configured")

resource_collision_failed: bool = False
try:
    render_metrics_with_resource(MetricCollection(100, 200, []), resource, ["service.name", "service/name"], 1024)
except TelemetryError as e:
    resource_collision_failed = True
nox.test.assert_true(resource_collision_failed, "target_info rejects allowlist labels that collide after normalization")

target_info_data: UpDownStorageSnapshot = UpDownStorageSnapshot([UpDownPointSnapshot(snapshot_attributes({}, default_attribute_limits(), True), 1, False)], 0, 0)
target_info_metrics: list[MetricSnapshot] = [MetricSnapshot(scope, MetricDescriptorSnapshot("target_info", InstrumentKind.UpDownCounter, "1", ""), 100, 200, MetricData.UpDownCounter(target_info_data))]
target_info_collision_failed: bool = False
try:
    render_metrics_with_resource(MetricCollection(100, 200, target_info_metrics), resource, ["service.name"], 1024)
except TelemetryError as e:
    target_info_collision_failed = True
nox.test.assert_true(target_info_collision_failed, "target_info rejects a conflicting user metric family")

resource_bound_failed: bool = False
try:
    render_metrics_with_resource(MetricCollection(100, 200, []), resource, ["service.name"], 1)
except TelemetryError as e:
    resource_bound_failed = True
nox.test.assert_true(resource_bound_failed, "target_info is included in the configured output byte bound")

oversized_allowlist: list[str] = []
allowlist_index: int = 0
while allowlist_index < 33:
    oversized_allowlist.append("resource.key." + str(allowlist_index))
    allowlist_index += 1
oversized_allowlist_failed: bool = False
try:
    render_metrics_with_resource(MetricCollection(100, 200, []), resource, oversized_allowlist, 4096)
except TelemetryError as e:
    oversized_allowlist_failed = True
nox.test.assert_true(oversized_allowlist_failed, "target_info enforces the resource-label allowlist hard bound")

scrape: HttpResponse = scrape_response_with_resource(HttpRequest("GET", "/metrics?ignored=1", "", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
nox.test.assert_eq_int(scrape.status, 200, "scrape adapter serves the configured path")
nox.test.assert_eq_str(scrape.headers["Content-Type"], PROMETHEUS_CONTENT_TYPE, "scrape adapter declares Prometheus text 0.0.4")
nox.test.assert_eq_str(scrape.headers["Cache-Control"], "no-store", "scrape adapter disables response caching")
nox.test.assert_true(nox.strings.contains(scrape.body, "target_info{service_name=\"checkout-api\"} 1"), "scrape adapter renders allowlisted Resource metadata")

missing_scrape: HttpResponse = scrape_response_with_resource(HttpRequest("GET", "/other", "", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
nox.test.assert_eq_int(missing_scrape.status, 404, "scrape adapter rejects other paths")
method_scrape: HttpResponse = scrape_response_with_resource(HttpRequest("POST", "/metrics", "", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
nox.test.assert_eq_int(method_scrape.status, 405, "scrape adapter rejects non-GET methods")
nox.test.assert_eq_str(method_scrape.headers["Allow"], "GET", "method rejection advertises only GET")
body_scrape: HttpResponse = scrape_response_with_resource(HttpRequest("GET", "/metrics", "unexpected", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
nox.test.assert_eq_int(body_scrape.status, 400, "scrape adapter rejects request bodies")
failed_scrape: HttpResponse = scrape_response_with_resource(HttpRequest("GET", "/metrics", "", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 1)
nox.test.assert_eq_int(failed_scrape.status, 500, "scrape adapter contains renderer limit failures")
nox.test.assert_true(not nox.strings.contains(failed_scrape.body, "Prometheus payload"), "scrape adapter does not expose internal error details")

long_target: str = "/"
target_index: int = 0
while target_index < 4096:
    long_target += "x"
    target_index += 1
long_target_scrape: HttpResponse = scrape_response_with_resource(HttpRequest("GET", long_target, "", {}), "/metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
nox.test.assert_eq_int(long_target_scrape.status, 414, "scrape adapter bounds request targets even outside the HTTP server")

invalid_path_failed: bool = False
try:
    scrape_response_with_resource(HttpRequest("GET", "/metrics", "", {}), "metrics", MetricCollection(100, 200, metrics), resource, ["service.name"], 16384)
except TelemetryError as e:
    invalid_path_failed = True
nox.test.assert_true(invalid_path_failed, "scrape adapter rejects an invalid configured path")
